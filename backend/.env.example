PORT=5050
DATABASE_URL=postgresql://explore:explore@127.0.0.1:5432/explore
REDIS_URL=redis://127.0.0.1:6379
# Leave REDIS_URL unset on Railway if you have no Redis plugin (cache is optional).
# REDIS_DISABLED=1
CLIENT_ORIGIN=http://localhost:5174,http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@explorecollege.org
ADMIN_PASSWORD=CampusDesk2026!
PLATFORM_EMAIL=platform@explore.app
PLATFORM_PASSWORD=CampusDesk2026!
PUBLIC_ORG_SLUG=explore
# Optional: full public URL of this deploy (also auto-allows RAILWAY_PUBLIC_DOMAIN)
# PUBLIC_APP_URL=https://campusdesk-production-xxxx.up.railway.app

# Demo logins after seed (same passwords as above for staff; student is fixed):
# Org admin   /org-admin          admin@explorecollege.org / CampusDesk2026!
# Faculty     /faculty-portal     faculty@explorecollege.org / CampusDesk2026!
# Super admin /x7k2m9q4p8n3       platform@explore.app / CampusDesk2026!
# Student     /login              student@explorecollege.org / student123

# Comma-separated browser origins for Campus Desk UI and Explore website.
# On Railway, the service hostname is allowed automatically so SPA assets load.
# If DATABASE_URL is unset, boot starts embedded Postgres so login still works.

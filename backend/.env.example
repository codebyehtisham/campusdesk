PORT=5050
DATABASE_URL=file:./data/campusdesk.db
REDIS_URL=redis://127.0.0.1:6379
# Leave REDIS_URL unset on Railway if you have no Redis plugin (cache is optional).
# REDIS_DISABLED=1
CLIENT_ORIGIN=http://localhost:5174,http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@explorecollege.org
ADMIN_PASSWORD=CampusDesk2026!
PLATFORM_EMAIL=platform@explore.app
PLATFORM_PASSWORD=CampusDesk2026!
PUBLIC_ORG_SLUG=explore
# development | production (set development on Railway dev service only)
APP_ENV=production
# Optional: full public URL of this deploy (also auto-allows RAILWAY_PUBLIC_DOMAIN)
# PUBLIC_APP_URL=https://campusdesk-production-xxxx.up.railway.app
# Dev service example:
# APP_ENV=development
# PUBLIC_APP_URL=https://campusdesk-dev-xxxx.up.railway.app

# Demo logins after seed:
# Org admin   /org-admin          admin@explorecollege.org / CampusDesk2026!
# Officer     /faculty-portal     officer@explorecollege.org / CampusDesk2026!
# Faculty     /faculty-portal     faculty@explorecollege.org / CampusDesk2026!
# Super admin /x7k2m9q4p8n3       platform@explore.app / CampusDesk2026!
# Student     /login              student@explorecollege.org / student123
# Apply       /apply              (pick institute, or /apply?institute=explore)

# If DATABASE_URL is unset, boot uses SQLite:
#   - Railway: mount a volume at /data  →  file:/data/campusdesk.db  (survives redeploys)
#   - Local:   backend/data/campusdesk.db
# Or set DATA_DIR=/absolute/path for the SQLite folder.
# FORCE_DB_RESET=1  → prisma db push --accept-data-loss (wipes incompatible tables; avoid in prod)

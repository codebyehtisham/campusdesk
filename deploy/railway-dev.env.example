# Copy into Railway → dev service → Variables

APP_ENV=development
JWT_SECRET=replace-with-long-random-dev-only-secret
PUBLIC_APP_URL=https://YOUR-DEV-SERVICE.up.railway.app
REDIS_DISABLED=1

# Persist SQLite across redeploys: Railway → Volumes → mount path /data
# Leave DATABASE_URL unset, or set:
# DATABASE_URL=file:/data/campusdesk.db
